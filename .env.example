# edgeconnect-preconfig settings. Copy to .env and replace the placeholders; never commit .env.
# setup.sh writes one shared .env in the install folder, used by edgeconnect-auto, edgeconnect-preconfig and
# the edgeconnect-mcp server. Keys this toolkit ignores (for example <nickname>_mcp_get_only, orch_default)
# are documented in those repositories' .env.example.
#
# File format (common.parse_dotenv):
# - One KEY=value per line. Blank lines and lines starting with # are skipped; "export KEY=value" is allowed.
# - A non-empty line without "=" stops every command with "invalid dotenv line <N>".
# - Spaces around key and value are trimmed; one pair of matching quotes ('...' or "...") is removed.
# - No inline comments: "KEY=value # note" makes "value # note" the value. No ${VAR} expansion.
# - Key names are case-insensitive and "-" equals "_" (LAB_BASE_URL, lab-base-url, lab_base_url are one key).
# - A process environment variable of the same name overrides the .env value.
# - No timeout or cache setting is read: each HTTP request times out after 30 seconds (fixed in code).

# ---------------------------------------------------------------------------------------------
# Orchestrators and nicknames
# ---------------------------------------------------------------------------------------------
# orch_<N>=<nickname>: lists a profile. <N> is any whole number (orch_1, orch_2, ...). The nickname is what
#   you pass to --orchestrator / --validate-on. It is part of key names, so use letters, digits, "_" or "-"
#   (case is ignored and "-" is read as "_").
#   Only used to name the configured profiles in the "unknown or incomplete Orchestrator profile" error;
#   a profile works from its <nickname>_base_url and <nickname>_api_key lines alone.
# <nickname>_base_url: required. https:// URL of the Orchestrator, host name or IP, optional :port.
#   The path defaults to /gms/rest; a trailing "/", query and fragment are dropped.
#   Not https or no host: "base URL for '<nickname>' must be an https:// URL".
# <nickname>_api_key: required. Orchestrator API key (a read-only key is enough for list and capture;
#   /validate may need more, see README). Missing or empty base_url or api_key:
#   "unknown or incomplete Orchestrator profile '<nickname>' (configured: <orch_N values>)".

# Read-only reference Orchestrator profile
orch_1=prod
prod_base_url=https://orchestrator.example.com
prod_api_key=<API_KEY>

# Lab / staging Orchestrator profile (used for /validate and optional upload)
orch_2=lab
lab_base_url=https://lab-orchestrator.example.com
# lab_base_url=https://192.0.2.10:8443/gms/rest
lab_api_key=<API_KEY>

# ---------------------------------------------------------------------------------------------
# TLS and authentication (optional, per nickname)
# ---------------------------------------------------------------------------------------------
# Order of precedence: _tls_sha256 if set, else _verify_tls=false, else _ca_bundle, else the system CA store.
# A nickname never changes certificate checks by itself.
#
# <nickname>_tls_sha256: pin a self-signed certificate: trust exactly the certificate with this SHA-256
#   fingerprint (host name not checked). 64 hex digits; colons, spaces and case are ignored, so the
#   fingerprint part of "openssl x509 -noout -fingerprint -sha256 -in cert.pem" can be pasted as is.
#   Anything else: "<nickname>_tls_sha256 must be the certificate's SHA-256 fingerprint: 64 hex digits,
#   colons allowed". A certificate that does not match stops the request. Default: unset (normal checks).
# Self-signed lab certificate: pin it instead of turning checks off.
# lab_tls_sha256=<SHA-256 fingerprint, e.g. from: openssl x509 -noout -fingerprint -sha256>
# lab_tls_sha256=AB:CD:EF:01:23:45:67:89:AB:CD:EF:01:23:45:67:89:AB:CD:EF:01:23:45:67:89:AB:CD:EF:01:23:45:67:89
#
# <nickname>_ca_bundle: PEM file of the private CA that signed the Orchestrator certificate, used instead of
#   the system CA store. Absolute path, or relative to the folder you run from; "~" is not expanded.
#   Default: unset or empty = system CA store. A missing file stops the command with a FileNotFoundError.
# prod_ca_bundle=/etc/ssl/private-ca.pem
#
# <nickname>_verify_tls: "false", "0" or "no" (any case) turns certificate checks off. Not recommended:
#   prefer _tls_sha256. Any other value, empty or unset = checks on (an unknown value such as "off" is
#   silently treated as on). Ignored when _tls_sha256 is set.
# lab_verify_tls=true
#
# <nickname>_api_key_header: HTTP header that carries the API key. Default: X-Auth-Token (also when empty).
#   Sent as given, not checked; a wrong name shows only when the Orchestrator rejects the request.
# prod_api_key_header=X-Auth-Token

# ---------------------------------------------------------------------------------------------
# Validators
# ---------------------------------------------------------------------------------------------
# EC_VALIDATORS: Orchestrators /validate may run on (build, variables, compare, validate, render, check).
#   Comma-separated exact nicknames as named in orch_N; spaces around names are ignored, case is ignored,
#   and "-" and "_" are treated the same. No name is allowed for what it contains (docs/decisions/0011).
#   Default: unset or empty = none allowed; a nickname not listed is refused with
#   "<nickname> is not a validator Orchestrator ... add it to EC_VALIDATORS in .env".
#   A listed nickname without a profile is accepted here and fails later as an unknown profile.
#   upload does not read this list; it sends only with --approve.
# orch_validators: alias of EC_VALIDATORS, same format; read only when EC_VALIDATORS is unset or empty.
# Orchestrators /validate may run on: exact nicknames, comma-separated; no other profile is allowed
EC_VALIDATORS=lab
# EC_VALIDATORS=lab,lab-2
# orch_validators=lab

# ---------------------------------------------------------------------------------------------
# Environment only: set these in the shell, not in this file (a .env line has no effect)
# ---------------------------------------------------------------------------------------------
# EC_DOTENV: path of the .env file to read. Default: the first .env found in the folder you run from, then
#   the skill folder and each folder above it, else none. The edgeconnect-preconfig command from setup.sh sets
#   it to the install folder's .env unless already set. A path that does not exist is silently read as empty,
#   so every profile is then "unknown or incomplete" and no Orchestrator may run /validate.
# export EC_DOTENV=/home/user/edgeconnect/.env
#
# PRECONFIG_WORK: folder for captures (reference/ and samples/) and downloaded default templates (reference/default-templates/). Default: preconfig-work/ in the install
#   folder when it exists, else ./preconfig-work in the folder you run from. Relative paths are relative to
#   the folder you run from; "~" is not expanded; an empty value means the current folder.
# export PRECONFIG_WORK=/home/user/preconfig-work
